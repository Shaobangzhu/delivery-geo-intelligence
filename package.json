{
  "name": "delivery-geo-intelligence",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "data:init-a1": "npm run data:init-a1 -w backend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend && npm run typecheck:e2e",
    "build": "npm run build -w frontend && npm run build -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs -f mongodb",
    "eval:ai": "npm run eval:ai -w backend",
    "data:import-uber-annual": "node --import tsx backend/src/importUberAnnual.ts",
    "lint": "eslint . --max-warnings=0",
    "test:coverage": "npm run test:coverage -w backend && npm run test:coverage -w frontend",
    "build:quality": "npm run build -w frontend -- --mode quality && npm run build -w backend",
    "quality:check": "npm run lint && npm run typecheck && npm run build:quality && npm run test:coverage && npm run eval:ai && npm run coverage:check",
    "test:backend:unit": "npm run test:unit -w backend",
    "test:backend:integration": "npm run test:integration -w backend",
    "test:frontend": "npm test -w frontend",
    "coverage:check": "node scripts/check-coverage.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=high",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "e2e:backend": "npm run build -w backend && node e2e/server.mjs",
    "e2e:frontend": "npm run e2e:serve -w frontend",
    "test:e2e": "node scripts/allure/run.mjs e2e chromium test",
    "test:e2e:repeat": "node scripts/allure/run.mjs e2e chromium test --repeat-each=3 --retries=0",
    "test:e2e:debug": "node scripts/allure/run.mjs e2e chromium test --debug",
    "test:e2e:report": "playwright show-report reports/e2e/html",
    "test:mongo:ready": "node scripts/wait-for-test-mongo.mjs",
    "allure:clean": "node scripts/allure/report.mjs clean",
    "allure:generate": "node scripts/allure/report.mjs generate",
    "allure:open": "allure open artifacts/allure-report --host 127.0.0.1",
    "allure:test": "node scripts/allure/report.mjs test",
    "allure:verify": "node scripts/allure/verify.mjs",
    "allure:publish:prepare": "node scripts/allure/release.mjs local",
    "allure:publish:check": "node scripts/allure/release.mjs check",
    "allure:publish:deploy": "node scripts/allure/release.mjs deploy"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "adm-zip": "0.6.1",
    "allure": "3.22.1",
    "allure-js-commons": "3.14.0",
    "allure-playwright": "3.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@allurereport/web-commons": {
      "dompurify": "3.4.17"
    }
  }
}
