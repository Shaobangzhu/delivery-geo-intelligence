{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "data:init-a1": "tsx src/initializeVehicleEconomics.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node test/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.evals.json",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "eval:ai": "tsc -p tsconfig.evals.json && node --import tsx evals/runner.ts",
    "lint": "eslint src evals test --max-warnings=0",
    "test:coverage": "npm run build && c8 node test/run.mjs",
    "test:unit": "npm run build && node test/run.mjs unit",
    "test:integration": "npm run build && node test/run.mjs integration"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "openai": "^7.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.10.2",
    "c8": "12.0.0",
    "mongodb-memory-server-core": "11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
